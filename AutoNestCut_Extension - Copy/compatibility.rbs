# Encoded Ruby file - AutoNestCut
require_relative 'rgloader/rgloader'

encoded_data = ""

begin
  require 'base64'
  require 'zlib'
  decoded = Base64.strict_decode64(encoded_data)
  source = Zlib::Inflate.inflate(decoded)
  eval(source, binding, "compatibility.rb")
rescue => e
  puts "Error loading encoded file: #{e.message}"
  raise e
end
